{
  "$schema": "https://ferrflow.com/schema/ferrflow.json",
  "workspace": {
    "latestTag": "latest",
    "releaseCommitBody": "full",
    "recoverMissedReleases": true,
    "skipCi": true
  },
  "package": [
    {
      "name": "changelog",
      "path": ".",
      "changelog": "CHANGELOG.md"
    }
  ]
}
